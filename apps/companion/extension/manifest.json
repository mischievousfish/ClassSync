{
  "manifest_version": 3,
  "name": "ClassSync Companion",
  "version": "1.0.0",
  "description": "Capture web learning materials, autofill grades, and trigger AI lesson prep from any webpage.",
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "contextMenus",
    "tabs",
    "downloads",
    "identity"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "src/backgroundWorker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/contentScript.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "ClassSync Companion",
    "default_popup": "src/popup.html"
  },
  "web_accessible_resources": [
    {
      "resources": ["src/*.js", "assets/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "oauth2": {
    "client_id": "YOUR_CLASSSYNC_CLIENT_ID",
    "scopes": [
      "openid",
      "email",
      "profile",
      "offline_access"
    ]
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+K"
      }
    }
  }
}
