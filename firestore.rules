rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function hasRole(role) {
      return signedIn() && request.auth.token.role == role;
    }

    function orgMember(orgId) {
      return signedIn()
        && exists(/databases/$(database)/documents/organization_memberships/$(orgId + '_' + request.auth.uid))
        && get(/databases/$(database)/documents/organization_memberships/$(orgId + '_' + request.auth.uid)).data.orgId == orgId;
    }

    function orgRole(orgId, role) {
      return orgMember(orgId)
        && get(/databases/$(database)/documents/organization_memberships/$(orgId + '_' + request.auth.uid)).data.orgRole == role;
    }

    function canManageOrg(orgId) {
      return orgRole(orgId, 'ORG_ADMIN');
    }

    function activeEnrollment(classId, studentId) {
      return exists(/databases/$(database)/documents/classEnrollments/$(classId + '_' + studentId))
        && get(/databases/$(database)/documents/classEnrollments/$(classId + '_' + studentId)).data.status == 'ACTIVE';
    }

    function ownsClass(classId) {
      return signedIn()
        && get(/databases/$(database)/documents/classes/$(classId)).data.teacherId == request.auth.uid;
    }

    match /users/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create: if signedIn() && request.auth.uid == userId
        && request.resource.data.role == request.auth.token.role;
      allow update: if signedIn() && request.auth.uid == userId
        && request.resource.data.role == resource.data.role;
      allow delete: if signedIn() && request.auth.uid == userId;
    }

    match /classes/{classId} {
      allow create: if hasRole('TEACHER') && request.resource.data.teacherId == request.auth.uid;
      allow update, delete: if hasRole('TEACHER') && resource.data.teacherId == request.auth.uid;
      // Class-code lookup and enrollment are performed by the authenticated API.
      // Direct client reads are limited to enrolled students or the owning teacher.
      allow read: if ownsClass(classId) || activeEnrollment(classId, request.auth.uid);
    }

    match /classEnrollments/{enrollmentId} {
      allow read: if signedIn() && (resource.data.studentId == request.auth.uid || ownsClass(resource.data.classId));
      allow create: if hasRole('STUDENT')
        && request.resource.data.studentId == request.auth.uid
        && request.resource.data.status == 'ACTIVE'
        && enrollmentId == request.resource.data.classId + '_' + request.auth.uid;
      allow update: if ownsClass(resource.data.classId);
      allow delete: if ownsClass(resource.data.classId) || resource.data.studentId == request.auth.uid;
    }

    match /assignments/{assignmentId} {
      allow create: if hasRole('TEACHER') && request.resource.data.teacherId == request.auth.uid
        && ownsClass(request.resource.data.classId);
      allow update, delete: if hasRole('TEACHER') && resource.data.teacherId == request.auth.uid
        && ownsClass(resource.data.classId);
      allow read: if signedIn() && (resource.data.teacherId == request.auth.uid
        || (hasRole('STUDENT') && activeEnrollment(resource.data.classId, request.auth.uid)));
    }

    match /studentMicroProfiles/{profileId} {
      // Students, including the profiled student, have no read or write access.
      allow read: if ownsClass(resource.data.classId);
      allow create: if ownsClass(request.resource.data.classId);
      allow update, delete: if ownsClass(resource.data.classId);
    }

    match /studentSchedules/{studentId}/items/{itemId} {
      allow read: if signedIn() && request.auth.uid == studentId;
      allow write: if false;
    }

    match /ai_generated_assets/{assetId} {
      allow read, write: if signedIn() && resource.data.teacherId == request.auth.uid;
      allow create: if hasRole('TEACHER') && request.resource.data.teacherId == request.auth.uid;
    }

    match /syncJobs/{jobId} {
      allow read, write: if false;
    }

    match /organizations/{orgId} {
      allow read: if orgMember(orgId);
      allow create: if signedIn() && request.resource.data.id == orgId
        && getAfter(/databases/$(database)/documents/organization_memberships/$(orgId + '_' + request.auth.uid)).data.orgRole == 'ORG_ADMIN';
      allow update, delete: if canManageOrg(orgId);
    }

    match /branches/{branchId} {
      allow read: if orgMember(resource.data.orgId);
      allow create: if canManageOrg(request.resource.data.orgId);
      allow update, delete: if canManageOrg(resource.data.orgId);
    }

    match /organization_memberships/{membershipId} {
      allow read: if orgMember(resource.data.orgId);
      allow create: if canManageOrg(request.resource.data.orgId)
        || (signedIn() && request.resource.data.userId == request.auth.uid
          && request.resource.data.orgRole == 'ORG_ADMIN'
          && getAfter(/databases/$(database)/documents/organizations/$(request.resource.data.orgId)).data.id == request.resource.data.orgId);
      allow update, delete: if canManageOrg(resource.data.orgId);
    }

    match /shared_curriculum_library/{itemId} {
      allow read: if orgMember(resource.data.orgId);
      allow create: if orgMember(request.resource.data.orgId) && request.resource.data.createdById == request.auth.uid;
      allow update, delete: if canManageOrg(resource.data.orgId)
        || (orgMember(resource.data.orgId) && resource.data.createdById == request.auth.uid);
    }

    match /organization_invitations/{invitationId} {
      allow read: if canManageOrg(resource.data.orgId);
      allow create: if canManageOrg(request.resource.data.orgId);
      allow update, delete: if canManageOrg(resource.data.orgId);
    }

    match /parent_profiles/{profileId} {
      allow read: if signedIn() && request.auth.uid == resource.data.userId;
      allow create: if signedIn() && request.auth.uid == request.resource.data.userId;
      allow update: if signedIn() && request.auth.uid == resource.data.userId && request.resource.data.userId == resource.data.userId;
      allow delete: if signedIn() && request.auth.uid == resource.data.userId;
    }

    match /tuition_bills/{billId} {
      allow read: if orgMember(resource.data.orgId);
      allow create, update: if canManageOrg(request.resource.data.orgId);
      allow delete: if canManageOrg(resource.data.orgId);
    }

    match /attendance_records/{recordId} {
      allow read: if orgMember(resource.data.orgId);
      allow create, update: if orgMember(request.resource.data.orgId);
      allow delete: if canManageOrg(resource.data.orgId);
    }

    match /parent_notification_events/{eventId} {
      allow read, write: if false;
    }

    match /assignmentSubmissions/{submissionId} {
      allow read: if signedIn() && (resource.data.studentId == request.auth.uid || orgMember(resource.data.orgId));
      allow create: if signedIn() && request.resource.data.studentId == request.auth.uid;
      allow update: if signedIn() && resource.data.studentId == request.auth.uid;
      allow delete: if false;
    }

    match /student_diagnostic_notes/{noteId} {
      allow read: if orgMember(resource.data.orgId);
      allow create: if orgMember(request.resource.data.orgId);
      allow update: if orgMember(resource.data.orgId);
      allow delete: if canManageOrg(resource.data.orgId);
    }

    match /student_gamification_profiles/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create, update: if false;
      allow delete: if false;
    }

    match /quests_daily/{questId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow update: if false;
      allow create, delete: if false;
    }

    match /badges_master/{badgeId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /gamification_events/{eventId} {
      allow read, write: if false;
    }

  }
}
