{
  "name": "classsync",
  "version": "1.0.0",
  "private": true,
  "description": "Core API for ClassSync student and teacher workflows",
  "main": "apps/backend/dist/server.js",
  "scripts": {
    "dev": "tsx watch apps/backend/src/server.ts",
    "build": "tsc -p apps/backend/tsconfig.json",
    "start": "node apps/backend/dist/server.js",
    "typecheck": "tsc --noEmit -p apps/backend/tsconfig.json",
    "test": "jest --config jest.config.js --runInBand",
    "test:coverage": "jest --config jest.config.js --coverage --runInBand",
    "web:dev": "next dev apps/web",
    "web:build": "next build apps/web",
    "web:start": "next start apps/web"
  },
  "dependencies": {
    "@google/genai": "^2.19.0",
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@react-native-firebase/app": "^26.3.2",
    "@react-native-firebase/messaging": "^26.3.2",
    "@react-navigation/bottom-tabs": "^7.18.18",
    "@react-navigation/native": "^7.3.18",
    "@react-navigation/native-stack": "^7.18.10",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "expo": "^57.0.17",
    "expo-image-picker": "^57.0.14",
    "expo-status-bar": "^57.0.1",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.2",
    "firebase-admin": "^13.0.2",
    "framer-motion": "^13.1.1",
    "helmet": "^8.0.0",
    "lucide-react": "^1.35.0",
    "lucide-react-native": "^1.35.0",
    "multer": "^2.2.0",
    "next": "^15.5.24",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-native-safe-area-context": "^5.9.1",
    "react-native-screens": "^4.27.0",
    "react-native-svg": "^15.15.5",
    "zod": "^3.24.1",
    "zustand": "^5.0.15"
  },
